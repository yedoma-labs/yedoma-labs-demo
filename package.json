{
  "name": "yedoma-labs-demo",
  "version": "0.3.0",
  "private": true,
  "description": "Comprehensive demo showcasing Yedoma Labs TypeScript ecosystem for Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run typecheck && pnpm run build"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@yedoma-labs/bylyt-env-guard": "0.3.7",
    "@yedoma-labs/ichchi-state": "0.1.2",
    "@yedoma-labs/keler-temporal": "0.1.3",
    "@yedoma-labs/sir-forms": "0.3.2",
    "@yedoma-labs/suruk-logger": "0.3.1",
    "@yedoma-labs/suruy-form-actions": "0.1.1",
    "@yedoma-labs/tierde-mail": "0.9.2",
    "@yedoma-labs/turar-config": "0.3.2",
    "@yedoma-labs/tuuru-chrono-tz": "0.3.3",
    "next": "16.4.3",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "temporal-polyfill": "^1.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "7.0.2"
  }
}
